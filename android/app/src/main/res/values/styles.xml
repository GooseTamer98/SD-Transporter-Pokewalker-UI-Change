<resources>
 <!-- Pokewalker look: white shell, red cap, gray-green LCD, near-black pixels. -->
 <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">monospace</item>
  <item name="android:colorAccent">#232B1D</item>
  <item name="android:colorPrimary">#D8283A</item>
  <item name="android:colorControlActivated">#232B1D</item>
  <item name="android:windowBackground">#ECEAE4</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:windowLightNavigationBar">true</item>
  <item name="android:statusBarColor">#D8283A</item>
  <item name="android:navigationBarColor">#ECEAE4</item>
  <item name="android:windowActionModeOverlay">true</item>
  <item name="android:alertDialogTheme">@style/WalkerDialog</item>
  <item name="android:textColorPrimary">#232B1D</item>
  <item name="android:textColorSecondary">#555E4C</item>
 </style>
 <style name="WalkerDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
  <item name="android:fontFamily">monospace</item>
  <item name="android:colorAccent">#232B1D</item>
  <item name="android:colorBackground">#B4B7AA</item>
  <item name="android:textColorPrimary">#232B1D</item>
  <item name="android:textColorSecondary">#232B1D</item>
  <item name="android:windowBackground">@drawable/lcd_dialog_bg</item>
 </style>
</resources>
